# GitHub Token (PAT，需要 public_repo scope)
# 强烈推荐填写：认证后 Search API 速率从 10次/分钟 提升到 30次/分钟
# 申请地址: https://github.com/settings/tokens
G1K_GITHUB_TOKEN=

# （可选）多 token 轮询加速：每个 token 独立享有 30 次/分钟限额，
# 填入多个 PAT 后，冷启动可成倍提速。逗号分隔。
# 例：G1K_GITHUB_TOKENS=ghp_xxx1,ghp_xxx2,ghp_xxx3
# G1K_GITHUB_TOKENS=

# 企业微信 Webhook（可选，留空则不推送）
G1K_WECOM_WEBHOOK_URL=

# 报告展示的 Top N 条目（0 = 全部）
G1K_REPORT_TOP_N=0

# 摘要报告和企业微信展示的 Top N 条目
G1K_SUMMARY_TOP_N=20

# 完整报告公开访问基础地址（例如腾讯云 COS 访问域名；留空则只使用 Actions Artifact）
# G1K_REPORT_PUBLIC_BASE_URL=https://your-bucket.cos.ap-guangzhou.myqcloud.com

# ── 高级参数（可选，留空使用默认值）─────────────────────────────
# 仅扫描此日期之后创建的仓库；留空表示不限制
# G1K_CREATED_SINCE=2020-01-01

# API 请求间隔（秒），30次/分钟精确节流
# G1K_REQUEST_INTERVAL=2.0

# 突破区上界（star 数），一天涨幅超过此值视为爆款
# G1K_ABOVE_UPPER=50000

# 候选区下界（star 数），离 1000 差值大于此阈值的不追踪
# G1K_CANDIDATE_LOWER=500

# 快照保留天数
# G1K_SNAPSHOT_KEEP_DAYS=30

# HTTP 请求最大重试次数
# G1K_HTTP_MAX_RETRIES=3
